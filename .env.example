# Environment Configuration Example
# Copy this file to .env: cp .env.example .env

# Server port
PORT=3500

# Web Dashboard Login Password
APP_PASSWORD=change_this_password

# Target phone number for WhatsApp emergency alerts (e.g. 33612345678)
# If left blank, alerts are sent to the bot's own WhatsApp number
ALERT_TARGET_NUMBER=

# Alert notification message language (en or fr)
ALERT_LANGUAGE=en

# Session timeout in hours (default: 24)
SESSION_TIMEOUT_HOURS=24

# Environment mode
NODE_ENV=production
